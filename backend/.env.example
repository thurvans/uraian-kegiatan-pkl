NODE_ENV=development
PORT=4000

# Database lokal (PostgreSQL).
# Bila ingin menggunakan Prisma Postgres dari project Vercel di komputer lokal,
# jalankan `vercel link` lalu `vercel env pull` agar DATABASE_URL tersimpan otomatis di .env.local.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pkl_activity?schema=public

JWT_ISSUER=pkl-activity
JWT_AUDIENCE=pkl-web
JWT_ACCESS_TTL_MINUTES=30
JWT_SIGNING_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=0
REQUEST_BODY_LIMIT=2mb
COOKIE_SAME_SITE=lax

# Vercel Blob (private store). Disarankan: `vercel link` lalu `vercel env pull`
# agar BLOB_STORE_ID + VERCEL_OIDC_TOKEN (OIDC) tersimpan di .env.local.
# Alternatif di luar Vercel: isi BLOB_READ_WRITE_TOKEN.
BLOB_STORE_ID=
# Harus berupa Read-write token dari halaman pengaturan Blob store
# (diawali `vercel_blob_rw_`), bukan Vercel account/API token.
BLOB_READ_WRITE_TOKEN=
APP_TIMEZONE=Asia/Jakarta
PDF_EXPORT_MAX_REPORTS=30

