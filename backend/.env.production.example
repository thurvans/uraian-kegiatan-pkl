NODE_ENV=production

# ==============================================================================
# DATABASE - PRISMA POSTGRES (VERCEL OFFICIAL INTEGRATION)
# ==============================================================================
# Bila project Vercel telah di-connect dengan "Prisma Postgres" melalui menu
# Storage / Marketplace Vercel, Vercel OTOMATIS menyuntikkan environment variables
# baik tanpa prefix maupun dengan prefix nama database yang Anda buat, misalnya:
#   - DATABASE_URL / [PREFIX]_DATABASE_URL (contoh: uraian_DATABASE_URL)
#   - PRISMA_DATABASE_URL / [PREFIX]_PRISMA_DATABASE_URL (contoh: uraian_PRISMA_DATABASE_URL)
#   - POSTGRES_URL / [PREFIX]_POSTGRES_URL (contoh: uraian_POSTGRES_URL)
#
# Backend otomatis membaca semua format di atas secara cerdas. Anda TIDAK PERLU
# menambahkan atau meng-copy manual DATABASE_URL jika project sudah di-connect.
#
# Opsional (High Concurrency / Pooling):
# Jika ingin query runtime melalui connection pooler (pooled.db.prisma.io),
# tambahkan DATABASE_URL_POOLED dari console Prisma:
# DATABASE_URL_POOLED=postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require
#
# Bila backend dijalankan di luar Vercel (bukan serverless Vercel), isi manual:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ==============================================================================
# KEAMANAN & AUTENTIKASI
# ==============================================================================
JWT_ISSUER=pkl-activity
JWT_AUDIENCE=pkl-web
JWT_ACCESS_TTL_MINUTES=15
JWT_SIGNING_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=https://uraian-pkl.example.com
TRUST_PROXY=1
REQUEST_BODY_LIMIT=2mb
COOKIE_SAME_SITE=none

# ==============================================================================
# VERCEL BLOB (PRIVATE STORAGE UNTUK TANDA TANGAN MENTOR)
# ==============================================================================
# Hubungkan Blob Store ke project melalui dashboard Vercel Storage.
# Vercel akan otomatis menyuntikkan BLOB_STORE_ID dan VERCEL_OIDC_TOKEN (OIDC).
# BLOB_READ_WRITE_TOKEN hanya diperlukan jika backend berjalan di luar Vercel.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# ==============================================================================
# PENGATURAN UMUM APLIKASI
# ==============================================================================
APP_TIMEZONE=Asia/Jakarta
PDF_EXPORT_MAX_REPORTS=30

