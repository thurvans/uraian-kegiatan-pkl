NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_ISSUER=pkl-activity
JWT_AUDIENCE=pkl-web
JWT_ACCESS_TTL_MINUTES=15
JWT_SIGNING_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=https://uraian-pkl.example.com
TRUST_PROXY=1
REQUEST_BODY_LIMIT=2mb
COOKIE_SAME_SITE=none
# Vercel Blob (private): hubungkan store ke project; Vercel otomatis menambahkan
# BLOB_STORE_ID dan VERCEL_OIDC_TOKEN (OIDC). Jangan set VERCEL_OIDC_TOKEN manual.
# BLOB_READ_WRITE_TOKEN hanya diperlukan bila backend berjalan di luar Vercel.
APP_TIMEZONE=Asia/Jakarta
PDF_EXPORT_MAX_REPORTS=30
